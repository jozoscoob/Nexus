# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — API 수집 parquet 파일은 PII·독점 데이터 포함 가능 (CLAUDE.md §data)
data/raw/*.parquet
data/raw/**/*.parquet
# 자동 수집 원시 시장데이터는 라이선스·용량·세션 의미 검증 전 저장소에 커밋하지 않는다.
data/raw/Databento/**/*.csv
data/raw/Databento/**/*.xlsx
# xlsx_exports는 parquet에서 파이프라인이 재생성하는 열람 사본 (아티팩트) — README만 추적
data/raw/xlsx_exports/**/*.xlsx
# 수동 업로드 참조 데이터(Excel·PDF)는 커밋 허용
!data/raw/USDA/**/*.xlsx
!data/raw/FAO/**/*.pdf
!data/raw/**/.gitkeep
!data/raw/**/*.md

# Secrets
.env
*.env.local

# Azure ML / MLflow
mlruns/
mlartifacts/
.azureml/

# macOS
.DS_Store

# IDEs
.vscode/settings.json
.idea/

# Generated reports (pipeline outputs — not committed)
reports/pipeline/*.html
reports/pipeline/*.pdf
reports/pipeline/*.json
reports/data_quality/*.json

# pytest
.pytest_cache/
htmlcov/
.coverage

# Feature mart — data/raw에서 결정적으로 재생성되는 산출물(계약 yaml·리포트만 추적)
data/gold/*.parquet

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# 로컬 실행 로그 (D-053)
docker/logs/

# n8n-mcp 로컬 설정 — 실제 API 키가 들어가므로 커밋 금지(승인자가 로컬에서만 입력)
docker/.mcp.json

# 학술지 PDF 원문 — 저작권 문제로 로컬에만 보관, 커밋 금지 (추출 텍스트는 repo 밖 scratchpad에 있음)
data/raw/Market Structure (Production & Distribution)/PDF/

# Databento 대두 복합체(ZL·ZM·ZS) 정리본 — 승인자 지시(2026-11-19)로 커밋 허용: 단일 월물·거래량 순위·정의·통계(상품별)
!data/raw/Databento/GLBX.MDP3/OHLCV-1d/*/clean/*.csv
!data/raw/Databento/GLBX.MDP3/OHLCV-1d/*/clean/*.xlsx
!data/raw/Databento/GLBX.MDP3/OHLCV-1d/ZL/ZL_ohlcv-1d_2010-06-06_2026-08-12.csv
!data/raw/Databento/GLBX.MDP3/OHLCV-1d/ZL/ZL_ohlcv-1d.xlsx
!data/raw/Databento/GLBX.MDP3/Definitions/ZL/*.csv
!data/raw/Databento/GLBX.MDP3/Definitions/ZM/*.csv
!data/raw/Databento/GLBX.MDP3/Definitions/ZS/*.csv
!data/raw/Databento/GLBX.MDP3/Statistics/ZL/*.csv
!data/raw/Databento/GLBX.MDP3/Statistics/ZM/*.csv
!data/raw/Databento/GLBX.MDP3/Statistics/ZS/*.csv
# 원시 포털 다운로드(일별 zst 배치 폴더·다운로드 매니페스트 — 계정별 URL 포함)와 엑셀 잠금 파일은 제외
data/raw/Databento/**/GLBX-*/
data/raw/Databento/**/manifest.json
**/~$*
# Yahoo ZL=F 열람용 통합본 — 103 MB로 GitHub 파일 한도(100 MB) 초과
data/raw/Yahoo Finance/**/*.xlsx
