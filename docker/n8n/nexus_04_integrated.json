    720,
    100
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://runner:8000/run/run_report",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Runner-Token",
       "value": "={{ $env.RUNNER_TOKEN }}"
      }
     ]
    },
    "options": {
     "timeout": 7200000,
     "response": {
      "response": {
       "neverError": true,
       "fullResponse": true
      }
     }
    }
   },
   "id": "run_report",
   "name": "실행 보고(최종 산출물)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    960,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "const steps = [\"실행 보고(최종 산출물)\"];\nconst fails = [];\nfor (const s of steps) {\n  let r;\n  try { r = $(s).first().json; } catch (e) { continue; }   // 비활성 노드는 건너뜀\n  const body = r.body || r;\n  const code = r.statusCode ?? 200;\n  if (code >= 400 || (Array.isArray(body.failed) && body.failed.length)) {\n    fails.push({ step: s, status: code, failed: body.failed || body.error || null, log: body.log || null });\n  }\n}\nreturn [{ json: { workflow: $workflow.name, ok: fails.length === 0, fails, at: new Date().toISOString() } }];"
   },
   "id": "check",
   "name": "결과 점검",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "return $json.ok ? [] : [{ json: $json }];"
   },
   "id": "only_fail",
   "name": "실패만 통과",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1440,
    100
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://runner:8000/alert",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Runner-Token",
       "value": "={{ $env.RUNNER_TOKEN }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json) }}",
    "options": {}
   },
   "id": "alert",
   "name": "실패 알림 기록",
