   "id": "weekly_summary",
   "name": "주간 요약",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2400,
    360
   ]
  },
  {
   "parameters": {
    "jsCode": "const r = $json.body || $json; const tail = ((r.steps || [])[0] || {}).tail || '';\nconst m = tail.split('\\n').reverse().find(l => l.startsWith('__SUMMARY__'));\nconst s = m ? JSON.parse(m.slice(11)) : { subject: '[Nexus] ⚠️ 요약 생성 실패', body: tail.slice(-800), failed: true };\nreturn [{ json: s }];"
   },
   "id": "weekly_summary_parse",
   "name": "주간 요약 읽기",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2640,
