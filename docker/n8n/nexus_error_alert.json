{
 "id": "nexusErrorAlert01",
 "name": "Nexus 실패 알림",
 "active": false,
 "settings": {
  "timezone": "Asia/Seoul",
  "executionOrder": "v1"
 },
 "nodes": [
  {
   "parameters": {},
   "id": "err",
   "name": "워크플로우 오류",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://runner:8000/alert",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Runner-Token",
       "value": "={{ $env.RUNNER_TOKEN }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow.name, failed_node: $json.execution.lastNodeExecuted, error: $json.execution.error.message, at: new Date().toISOString() }) }}",
    "options": {}
   },
   "id": "alert",
   "name": "실패 알림 기록",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    240,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "return [{ json: { subject: `[Nexus] ❌ 워크플로우 중단 — ${$('워크플로우 오류').first().json.workflow.name}`, body: `중단 노드: ${$('워크플로우 오류').first().json.execution.lastNodeExecuted}\\n오류: ${$('워크플로우 오류').first().json.execution.error.message}` } }];"
   },
   "id": "errmsg",
   "name": "중단 메일 내용",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    480,
    0
   ]
  },
  {
   "parameters": {
    "fromEmail": "={{ $env.NEXUS_ALERT_EMAIL }}",
    "toEmail": "={{ $env.NEXUS_ALERT_EMAIL }}",
    "subject": "={{ $json.subject }}",
    "emailFormat": "text",
    "text": "={{ $json.body }}",
    "options": {
     "appendAttribution": false
    }
   },
   "id": "errmail",
   "name": "중단 메일 보내기",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
   "position": [
    720,
    0
   ],
   "credentials": {
    "smtp": {
     "id": "nexusSmtp01",
     "name": "Nexus Gmail SMTP"
    }
   },
   "onError": "continueRegularOutput"
  }
 ],
 "connections": {
  "워크플로우 오류": {
   "main": [
    [
     {
      "node": "실패 알림 기록",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "실패 알림 기록": {
   "main": [
    [
     {
      "node": "중단 메일 내용",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "중단 메일 내용": {
   "main": [
    [
     {
      "node": "중단 메일 보내기",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}